Screen {
    layout: vertical;
    background: $background;
}

/* ─────────────────────────────────────────────────────────────
   Conversation
   ───────────────────────────────────────────────────────────── */

#conversation {
    width: 1fr;
    height: 1fr;

    background: $background;
}


/* ─────────────────────────────────────────────────────────────
   Composer
   ───────────────────────────────────────────────────────────── */

#composer {
    width: 1fr;
    height: auto;

    padding: 0 2 1 2;
}

#chat-input {
    width: 1fr;
    height: 3;

    border: solid $panel;
    background: $surface;
}

#chat-input:focus {
    border: solid $accent;
}


/* ─────────────────────────────────────────────────────────────
   Activity / cooldown / footer
   ───────────────────────────────────────────────────────────── */

#activity {
    width: 1fr;
    height: auto;

    padding: 0 1;
}

#cooldown {
    width: 1fr;
    height: auto;

    padding: 0 1;
}

#footer {
    width: 1fr;
    height: auto;

    padding: 0 1;
}


/* ─────────────────────────────────────────────────────────────
   Landing
   ───────────────────────────────────────────────────────────── */

#landing {
    width: 1fr;
    height: 1fr;

    background: $background;
}