Screen {
    layout: vertical;
    background: $background;
}

/* ─────────────────────────────────────────────────────────────
   Conversation
   ───────────────────────────────────────────────────────────── */

#conversation {
    background: $background;
}


/* ─────────────────────────────────────────────────────────────
   Composer
   ───────────────────────────────────────────────────────────── */

#chat-input {
    height: auto;
    min-height: 3;
    max-height: 8;

    border: solid $panel;
    background: $surface;
}

#chat-input:focus {
    border: solid $accent;
}


/* ─────────────────────────────────────────────────────────────
   Activity / cooldown / footer
   ───────────────────────────────────────────────────────────── */

#activity-indicator {
    width: 1fr;
}

#cooldown-bar {
    width: 1fr;
}

#footer-stats {
    width: 1fr;
}


/* ─────────────────────────────────────────────────────────────
   Landing
   ───────────────────────────────────────────────────────────── */

#landing {
    background: $background;
}