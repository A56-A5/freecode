Screen {
    layout: vertical;
    background: $background;
}

#transcript-pane {
    height: 1fr;
}

#transcript-log {
    height: 1fr;
    background: $background;
    padding: 0 1;
}

#divider {
    color: $panel;
}

#activity-indicator {
    height: 1;
    padding: 0 1;
}

#chat-input {
    height: 3;
    margin: 0 1;
    border: solid $panel;
    background: $surface;
}

#chat-input:focus {
    border: solid $accent;
}

#cooldown-bar {
    height: 1;
    padding: 0 1;
}

#footer-stats {
    height: 1;
    padding: 0 1;
}
